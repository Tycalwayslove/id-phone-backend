# 复制为 deploy/.env 再填写，不提交到 git。
# 生成密码：openssl rand -hex 24（只含字母数字，放进连接地址不用转义）
POSTGRES_PASSWORD=
# 生成主密钥：openssl rand -hex 32。已有数据时保留原主密钥。
SECRET_KEY=

# 对外域名，同时用于 API 的 PUBLIC_BASE_URL。
NGINX_SERVER_NAME=idphone.example.com
NGINX_TLS_DIR=/etc/idphone/tls
NGINX_TLS_CERT_FILE=/etc/nginx/tls/fullchain.pem
NGINX_TLS_KEY_FILE=/etc/nginx/tls/privkey.pem
ACME_WEBROOT=/var/www/idphone-acme

# 正式服务配置。当前分支的支付和回执正式适配器仍待接入，见部署手册。
ALLOW_FAKE_IN_PROD=false
WECHAT_MODE=real
WX_MINI_APP_ID=
WX_MINI_APP_SECRET=
PAY_MODE=wechat
WXPAY_MCH_ID=
WXPAY_API_V3_KEY=
WXPAY_CERT_SERIAL=
WXPAY_CERT_DIR=/etc/idphone/wxpay
WXPAY_PRIVATE_KEY_PATH=/run/wxpay/apiclient_key.pem
WXPAY_PLATFORM_CERT_PATH=/run/wxpay/platform_cert.pem
RECEIPT_MODE=real
ZHEYING_APP_KEY=
ZHEYING_APP_SECRET=
CLIPIMG_APP_KEY=
CLIPIMG_APP_SECRET=

MATTING_MODE=fake
STORAGE_MODE=local
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_REGION=

# 备份目录 ./backups 的宿主机所有者（id -u / id -g）。
BACKUP_UID=1000
BACKUP_GID=1000
# 可选异地备份。填写 OSS 目标及仓库外的 ossutil 与配置目录。
BACKUP_OSS_URI=
# BACKUP_OSS_DIR=/etc/idphone/backup-oss
