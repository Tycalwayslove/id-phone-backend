{
  "name": "id-photo-miniapp",
  "version": "0.1.0",
  "private": true,
  "description": "智拍证件照 小程序（Taro 4 + React + TypeScript）",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "Sass",
    "framework": "React"
  },
  "scripts": {
    "gen:api": "openapi-typescript ../docs/api/openapi.json -o src/api/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "build": "taro build --type weapp",
    "build:h5": "taro build --type h5",
    "dev": "rm -f .env.development.local && taro build --type weapp --watch",
    "dev:h5": "taro build --type h5 --watch",
    "dev:device": "echo \"TARO_APP_API_BASE=http://$(ipconfig getifaddr en0):8000\" > .env.development.local && taro build --type weapp --watch"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@babel/runtime": "^7.24.0",
    "@nutui/icons-react-taro": "^2.0.0",
    "@nutui/nutui-react-taro": "^2.0.0",
    "@tarojs/components": "^4.0.0",
    "@tarojs/helper": "^4.0.0",
    "@tarojs/plugin-framework-react": "^4.0.0",
    "@tarojs/plugin-platform-h5": "^4.0.0",
    "@tarojs/plugin-platform-weapp": "^4.0.0",
    "@tarojs/react": "^4.0.0",
    "@tarojs/runtime": "^4.0.0",
    "@tarojs/shared": "^4.0.0",
    "@tarojs/taro": "^4.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.5",
    "@tarojs/cli": "^4.0.0",
    "@tarojs/taro-loader": "^4.0.0",
    "@tarojs/webpack5-runner": "^4.0.0",
    "@types/node": "^18.15.11",
    "@types/react": "^18.0.0",
    "@types/webpack-env": "^1.13.6",
    "babel-preset-taro": "^4.0.0",
    "openapi-typescript": "^7.0.0",
    "postcss": "^8.4.18",
    "react-refresh": "^0.14.0",
    "sass": "^1.75.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.4.0",
    "webpack": "5.97.1",
    "@babel/preset-react": "^7.24.1",
    "@babel/preset-typescript": "^7.24.1",
    "@babel/plugin-transform-runtime": "^7.24.3"
  }
}
