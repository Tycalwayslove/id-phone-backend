# 上线前改成已备案并在小程序后台配置了 request 合法域名的 https 地址
TARO_APP_API_BASE=https://api.example.com
# 生产环境必须为 0
TARO_APP_FAKE_PAY=0

# 私域引导：企业微信加好友链接/二维码与文案、公众号名称与文案；不填则不显示
TARO_APP_WECOM_URL=
TARO_APP_WECOM_QR_URL=
TARO_APP_WECOM_TEXT=
TARO_APP_MP_NAME=
TARO_APP_MP_TEXT=
# 订阅消息模板 ID（微信公众平台 → 订阅消息）；不填则隐藏“消息提醒设置”
TARO_APP_TPL_RECEIPT_COMPLETED=
TARO_APP_TPL_RECEIPT_REJECTED=
TARO_APP_TPL_ENTITLEMENT_EXPIRING=
