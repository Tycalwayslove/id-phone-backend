# 复制为 .env 再填写。.env 不提交到 git。

# 运行环境：dev（本机）/ test（自动化测试）/ prod（服务器）
APP_ENV=dev

# 数据库连接。现在指向本机 Postgres.app；迁到服务器时只改这一行
DATABASE_URL=postgresql+psycopg://idphone_app:你的密码@localhost:5432/idphone_dev

# 打印每条 SQL（排查问题时临时改成 true；服务器上保持 false）
DB_ECHO=false

# 对外访问地址（拼文件下载链接）与主密钥（生产必须换：openssl rand -hex 32）
PUBLIC_BASE_URL=http://localhost:8000
SECRET_KEY=

# 外部服务模式：没有正式账号时用 fake 跑通整条链路。
# APP_ENV=prod 时 WECHAT_MODE/PAY_MODE/RECEIPT_MODE 不能是 fake、SECRET_KEY 不能是默认值，
# 除非 ALLOW_FAKE_IN_PROD=true（只用于演示环境）。
ALLOW_FAKE_IN_PROD=false

# 微信小程序
WECHAT_MODE=fake
WX_MINI_APP_ID=
WX_MINI_APP_SECRET=
# 小程序消息推送使用明文 JSON，回调路径为 /api/v1/callbacks/wechat/media-check。
WX_MSG_TOKEN=

# 微信支付（PAY_MODE=wechat 时必填；证书与私钥放仓库外，这里只写路径）
PAY_MODE=fake
WXPAY_MCH_ID=
WXPAY_API_V3_KEY=
WXPAY_CERT_SERIAL=
WXPAY_PRIVATE_KEY_PATH=
WXPAY_PLATFORM_CERT_PATH=
# 微信支付公钥可替代平台证书，也可在切换期间同时配置。
WXPAY_PUBLIC_KEY_PATH=
WXPAY_PUBLIC_KEY_ID=
# 留空时使用 PUBLIC_BASE_URL 加支付 / 退款回调路径，真实模式需公网 HTTPS。
WXPAY_NOTIFY_URL=
WXPAY_REFUND_NOTIFY_URL=

# 文件存储：local 本机目录 / oss 阿里云
STORAGE_MODE=local
LOCAL_STORAGE_DIR=storage
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_REGION=

# 抠图与美颜
MATTING_MODE=fake
MATTING_TIMEOUT_SECONDS=5

# 回执服务商
RECEIPT_MODE=fake
ZHEYING_API_BASE=https://api.zjzapi.com
ZHEYING_APP_KEY=
CLIPIMG_API_BASE=https://www.qwyun.top
CLIPIMG_APP_KEY=
# 真实回执回调的来源 IP 或 CIDR，逗号分隔，留空则不限。
RECEIPT_CALLBACK_IP_ALLOWLIST=

# 定时任务 worker 每轮间隔（秒）
WORKER_INTERVAL_SECONDS=60

# 通知渠道，按逗号分隔。全渠道为 mini_subscribe,mp_template,wecom,sms
NOTIFY_CHANNELS=mini_subscribe
MINI_SUBSCRIBE_MODE=fake
MP_TEMPLATE_MODE=fake
# 企业微信的 real 模式会跳过，等待接入员工确认流程。
WECOM_MODE=fake
SMS_MODE=fake

# 小程序真实发送复用上面 WX_MINI_APP_ID/SECRET；公众号使用独立凭据。
WX_MP_APP_ID=
WX_MP_APP_SECRET=
# 按事件配置模板，例如 {"receipt_completed":{"template_id":"...","data":{"thing1":"办理成功"}}}
# 小程序模板还可以配置 page。
MINI_SUBSCRIBE_TEMPLATES={}
MP_TEMPLATE_TEMPLATES={}

# 阿里云短信，按事件配置已审核的模板和变量。
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
# 例如 {"receipt_completed":{"template_code":"SMS_123456","params":{"status":"办理成功"}}}
SMS_TEMPLATES={}

