# 复制为 .env 再填写。.env 不提交到 git。

# 运行环境：dev（本机）/ test（自动化测试）/ prod（服务器）
APP_ENV=dev

# 数据库连接。现在指向本机 Postgres.app；迁到服务器时只改这一行
DATABASE_URL=postgresql+psycopg://idphone_app:你的密码@localhost:5432/idphone_dev

# 打印每条 SQL（排查问题时临时改成 true；服务器上保持 false）
DB_ECHO=false

# 对外访问地址（拼文件下载链接）与主密钥（生产必须换：openssl rand -hex 32）
PUBLIC_BASE_URL=http://localhost:8000
SECRET_KEY=

# 外部服务模式：没有正式账号时用 fake 跑通整条链路。
# APP_ENV=prod 时 WECHAT_MODE/PAY_MODE/RECEIPT_MODE 不能是 fake、SECRET_KEY 不能是默认值，
# 除非 ALLOW_FAKE_IN_PROD=true（只用于演示环境）。
ALLOW_FAKE_IN_PROD=false

# 微信小程序
WECHAT_MODE=fake
WX_MINI_APP_ID=
WX_MINI_APP_SECRET=

# 微信支付（PAY_MODE=wechat 时必填；证书与私钥放仓库外，这里只写路径）
PAY_MODE=fake
WXPAY_MCH_ID=
WXPAY_API_V3_KEY=
WXPAY_CERT_SERIAL=
WXPAY_PRIVATE_KEY_PATH=
WXPAY_PLATFORM_CERT_PATH=

# 文件存储：local 本机目录 / oss 阿里云
STORAGE_MODE=local
LOCAL_STORAGE_DIR=storage
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_REGION=

# 抠图与美颜
MATTING_MODE=fake
MATTING_TIMEOUT_SECONDS=5

# 回执服务商
RECEIPT_MODE=fake
ZHEYING_API_BASE=https://api.zjzapi.com
ZHEYING_APP_KEY=
CLIPIMG_API_BASE=https://www.qwyun.top
CLIPIMG_APP_KEY=

# 定时任务 worker 每轮间隔（秒）
WORKER_INTERVAL_SECONDS=60
